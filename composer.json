{
    "name": "laravel/vjays-bike-backend",
    "type": "project",
    "description": "Laravel API backend for Vjay's Bike Parts & Accessories Inventory System",
    "keywords": ["framework", "laravel", "inventory"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/app/",
            "Database\\Factories\\": "backend/database/factories/",
            "Database\\Seeders\\": "backend/database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
