APP_NAME="Vjay's Bike Parts API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database Configuration
# Local SQLite (Default)
DB_CONNECTION=sqlite

# Vercel Postgres / Neon PostgreSQL (Production on Vercel)
# Option A: Full Connection String (automatically provided by Vercel Postgres)
# POSTGRES_URL="postgres://default:password@ep-cool-fog-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# POSTGRES_URL_NON_POOLING="postgres://default:password@ep-cool-fog-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Option B: Standard Laravel / Postgres Parameters
# DB_CONNECTION=pgsql
# DB_HOST=ep-cool-fog-123456.us-east-1.postgres.vercel-storage.com
# DB_PORT=5432
# DB_DATABASE=verceldb
# DB_USERNAME=default
# DB_PASSWORD=your_password
# DB_SSLMODE=require

# Option C: MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vjays_bike
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

